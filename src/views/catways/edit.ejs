<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"><title><%= title %></title></head>
<body>
  <h1>Modifier catway</h1>

  <nav>
    <a href="/dashboard">Dashboard</a> |
    <a href="/catways">Catways</a> |
    <a href="/logout">Logout</a>
  </nav>

  <% if (error) { %>
    <p style="color:red;"><%= error %></p>
  <% } %>

  <form method="POST" action="/catways/<%= catway._id %>">
    <div>
      <label>Numéro</label>
      <input name="catwayNumber" type="number" value="<%= catway.catwayNumber %>" required />
    </div>

    <div>
      <label>Type</label>
      <select name="catwayType" required>
        <option value="short" <%= catway.catwayType === "short" ? "selected" : "" %>>short</option>
        <option value="long" <%= catway.catwayType === "long" ? "selected" : "" %>>long</option>
      </select>
    </div>

    <div>
      <label>État</label>
      <input name="catwayState" type="text" value="<%= catway.catwayState %>" required />
    </div>

    <button type="submit">Enregistrer</button>
  </form>

  <p><a href="/catways">← Retour</a></p>
</body>
</html>
