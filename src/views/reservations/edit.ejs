<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"><title><%= title %></title></head>
<body>
  <h1>Modifier réservation</h1>

  <nav>
    <a href="/dashboard">Dashboard</a> |
    <a href="/reservations">Réservations</a> |
    <a href="/logout">Logout</a>
  </nav>

  <% if (error) { %>
    <p style="color:red;"><%= error %></p>
  <% } %>

  <form method="POST" action="/reservations/<%= reservation._id %>">
    <div>
      <label>Catway</label>
      <select name="catwayNumber" required>
        <% catways.forEach(c => { %>
          <option value="<%= c.catwayNumber %>" <%= Number(reservation.catwayNumber) === Number(c.catwayNumber) ? "selected" : "" %>>
            <%= c.catwayNumber %> - <%= c.catwayType %> - <%= c.catwayState %>
          </option>
        <% }) %>
      </select>
    </div>

    <div>
      <label>Client</label>
      <input name="clientName" type="text" value="<%= reservation.clientName %>" required />
    </div>

    <div>
      <label>Bateau</label>
      <input name="boatName" type="text" value="<%= reservation.boatName %>" required />
    </div>

    <div>
      <label>Début</label>
      <input name="startDate" type="date" value="<%= new Date(reservation.startDate).toISOString().slice(0,10) %>" required />
    </div>

    <div>
      <label>Fin</label>
      <input name="endDate" type="date" value="<%= new Date(reservation.endDate).toISOString().slice(0,10) %>" required />
    </div>

    <button type="submit">Enregistrer</button>
  </form>

  <p><a href="/reservations">← Retour</a></p>
</body>
</html>
